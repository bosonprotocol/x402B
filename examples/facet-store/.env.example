# Copy to .env (git-ignored) and fill in. Real environment variables override .env.

# ── Required ────────────────────────────────────────────────────────────────
# Buyer wallet private key (hex, with or without 0x). Funds the escrow commit.
BUYER_PRIVATE_KEY=
# Public HTTPS URL of your published ucp-profile.json (a revision-pinned GitHub
# Gist raw URL works). Generate the profile with:  pnpm buy --init
# (purchase-ucp.ts --init writes the same files.)
UCP_PROFILE_URL=

# ── Safety ──────────────────────────────────────────────────────────────────
# Leave unset for a DRY RUN (nothing moves). Set to 1 to commit + redeem for real.
# SETTLE=1
# Max spend guardrail, in USDC (default 20).
# MAX_USDC=20

# ── Target (defaults shown) ───────────────────────────────────────────────────
# Sandbox = Base Sepolia test USDC. For production: TERMINAL=https://my-boson-shop-2.facet.llc  NETWORK=base
# TERMINAL=https://my-boson-shop-2.sandbox.facet.llc
# NETWORK=base-sepolia

# ── Optional ──────────────────────────────────────────────────────────────────
# Pin a product instead of auto-selecting the cheapest.
# PRODUCT_ID=
# QTY=1
# Ship-to (priced + sealed into the checkout).
# SHIP_RECIPIENT=Test Buyer
# SHIP_LINE1=1 Market Street
# SHIP_CITY=San Francisco
# SHIP_REGION=CA
# SHIP_POSTAL=94105
# SHIP_COUNTRY=US
# Commit→redeem confirmation polling.
# COMMIT_CONFIRM_ATTEMPTS=12
# COMMIT_CONFIRM_DELAY_MS=5000
# Overrides (rarely needed).
# SITE_ID=3623dfa8-3d62-45ba-8dee-1e63dd9a1cb0
# RAIL_ID=coin/boson-escrow
# AID=agent:my-tester
# RPC=
# USDC_ADDRESS=
# BOSON_SUBGRAPH_URL=
